{
  "format": "disasm-completion-config-v1",
  "target": {
    "path": "target.json",
    "sha256": "REPLACE"
  },
  "universe": {
    "path": "universe.json",
    "sha256": "REPLACE"
  },
  "callgraph": "callgraph.json",
  "work_pattern": "completion/{run}",
  "budget_seconds": 600,
  "tool_timeout_seconds": 60,
  "profile": {
    "reviewers": [
      "REPLACE_APPROVED_REVIEWER"
    ],
    "execution_kind": "pc-trace",
    "platform_images": {},
    "allowed_external_calls": []
  },
  "tools": {
    "compiler": {
      "argv": [
        "REPLACE_COMPILER",
        "{source}",
        "-o",
        "{output}"
      ],
      "preprocess_argv": [
        "REPLACE_COMPILER",
        "-E",
        "-P",
        "{source}",
        "-o",
        "{output}"
      ],
      "executable_sha256": "REPLACE",
      "files": {}
    },
    "executor": {
      "argv": [
        "REPLACE_RUNNER",
        "{stock}",
        "{image}",
        "{witnesses}",
        "{report}",
        "{unit}",
        "{entry}",
        "{run}"
      ],
      "executable_sha256": "REPLACE",
      "files": {}
    }
  },
  "units": {
    "U1": {
      "unit_manifest": "units/U1.json",
      "symbol": "REPLACE",
      "qualification": "reviews/U1.json",
      "witnesses": "witnesses/U1.json",
      "negative_source": "negative/U1.c",
      "build_inputs": []
    }
  }
}
