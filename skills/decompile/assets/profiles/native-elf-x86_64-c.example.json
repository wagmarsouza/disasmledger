{
  "format": "decompile-target-profile-v1",
  "id": "native-elf-x86_64-c-reviewed-template",
  "target": {
    "architectures": [
      "x86_64"
    ],
    "endianness": "little",
    "address_unit_bytes": 1,
    "isa_modes": [
      "native"
    ]
  },
  "language": "c",
  "backend": "c-source-v1",
  "reviewers": [
    "review-required"
  ],
  "dependencies": {
    "allowed_external_calls": [],
    "platform_images": {}
  },
  "build": {
    "format": "elf",
    "bits": 64,
    "machine": 62
  },
  "validation": {
    "method": "differential",
    "execution_kind": "process-image",
    "min_cases": 8,
    "observables": [
      "returncode",
      "stdout_hex",
      "stderr_hex",
      "termination"
    ],
    "required_scenarios": [
      "normal",
      "boundary"
    ],
    "assumptions": [
      "REPLACE: native ABI/runtime/input domain; process origin is not an instruction trace"
    ]
  },
  "stub_markers": [
    "halt_baddata",
    "Could not recover"
  ]
}
